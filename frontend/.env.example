# ==========================================
# 1. Supabase Configuration (PUBLIC - Browser Visible)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ==========================================
# 2. Backend & WebSocket Configuration (PUBLIC)
# ==========================================
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws/agent"

# ==========================================
# 3. Error Tracking Configuration (PUBLIC - Browser Visible)
# ==========================================
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-key@your-sentry-org.ingest.sentry.io/your-project-id"

# ==========================================
# 4. Build-Time Configuration (GitHub Actions Only)
# ==========================================
SENTRY_AUTH_TOKEN="your-sentry-auth-token-here"
