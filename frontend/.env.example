# Finrush Frontend — Environment Variables Template
# Copy this file to .env and fill with YOUR actual values
# NEVER commit .env (real values) to git

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...  # Project API key (anon/public)

# ─── Backend WebSocket URL ────────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/agent
# For production: wss://your-backend-domain.com/ws/agent

# ─── Optional Services ────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                   # Error monitoring (optional)
