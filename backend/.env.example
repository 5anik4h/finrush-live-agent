# ==========================================
# 1. Supabase Configuration
# ==========================================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
# ⚠️ CRITICAL: SERVICE_ROLE_KEY and JWT_SECRET must NEVER be in .env
# → Always inject via GitHub Secrets at runtime (see .github/workflows/deploy.yml)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_JWT_SECRET="your-jwt-secret-here"

# ==========================================
# 2. Google Cloud & Gemini Configuration
# ==========================================
# GCP Project ID (yours, not hardcoded)
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"

# Gemini Live API credentials
# ⚠️ CRITICAL: GEMINI_API_KEY must NEVER be in .env for production
# → Always inject via GitHub Secrets at runtime
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Live API settings (same for all environments)
GEMINI_MODEL="gemini-live-2.5-flash-native-audio"
GEMINI_VOICE_NAME="Erinome"
GEMINI_AUDIO_RATE="16000"

# ==========================================
# 3. Application Settings
# ==========================================
PORT="8000"
DEBUG="True"  # Set to False in production
ENV="development"  # Change to "production" when deploying

# CORS: Adjust to match your frontend URL
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGINS="http://localhost:3000"

# Sentry error tracking (optional)
# For production, get your Sentry DSN and inject via GitHub Secrets
SENTRY_DSN="https://your-sentry-dsn-here@sentry.io/your-project-id"

# ==========================================
# 4. Third-party APIs (Optional but Recommended)
# ==========================================
# Finnhub: Stock price fallback when Yahoo Finance blocks requests
# Then add to GitHub Secrets as FINNHUB_API_KEY for production
FINNHUB_API_KEY="your-finnhub-api-key-here"
